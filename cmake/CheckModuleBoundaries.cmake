# Check the active source list and keep non-UI modules independent of UI headers.

if(NOT DEFINED FOREST_APP_SOURCES OR "${FOREST_APP_SOURCES}" STREQUAL "")
    message(FATAL_ERROR "FOREST_APP_SOURCES must be defined before checking module boundaries.")
endif()

set(_forest_registered_source_keys "")
foreach(_forest_source IN LISTS FOREST_APP_SOURCES)
    get_filename_component(
        _forest_source_path "${_forest_source}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    file(TO_CMAKE_PATH "${_forest_source_path}" _forest_source_path)
    if(NOT EXISTS "${_forest_source_path}" OR IS_DIRECTORY "${_forest_source_path}")
        message(FATAL_ERROR "FOREST_APP_SOURCES entry does not exist: ${_forest_source}")
    endif()

    string(TOLOWER "${_forest_source_path}" _forest_source_key)
    list(FIND _forest_registered_source_keys "${_forest_source_key}" _forest_duplicate_index)
    if(NOT _forest_duplicate_index EQUAL -1)
        message(FATAL_ERROR "Duplicate production source in FOREST_APP_SOURCES: ${_forest_source}")
    endif()
    list(APPEND _forest_registered_source_keys "${_forest_source_key}")
endforeach()

set(_forest_qt_widgets_include_dirs "")
if(TARGET Qt6::Widgets)
    get_target_property(
        _forest_target_qt_widgets_include_dirs Qt6::Widgets INTERFACE_INCLUDE_DIRECTORIES)
    if(_forest_target_qt_widgets_include_dirs)
        list(APPEND _forest_qt_widgets_include_dirs ${_forest_target_qt_widgets_include_dirs})
    endif()
endif()
if(DEFINED Qt6Widgets_INCLUDE_DIRS)
    list(APPEND _forest_qt_widgets_include_dirs ${Qt6Widgets_INCLUDE_DIRS})
endif()

set(_forest_qt_widgets_header_names "")
foreach(_forest_include_dir IN LISTS _forest_qt_widgets_include_dirs)
    if(_forest_include_dir MATCHES "^\\$<")
        continue()
    endif()

    file(TO_CMAKE_PATH "${_forest_include_dir}" _forest_include_dir)
    get_filename_component(_forest_include_dir_name "${_forest_include_dir}" NAME)
    if(_forest_include_dir_name STREQUAL "QtWidgets")
        set(_forest_widgets_dir "${_forest_include_dir}")
    else()
        set(_forest_widgets_dir "${_forest_include_dir}/QtWidgets")
    endif()

    if(IS_DIRECTORY "${_forest_widgets_dir}")
        file(GLOB _forest_widget_headers LIST_DIRECTORIES FALSE
            "${_forest_widgets_dir}/Q*"
            "${_forest_widgets_dir}/q*.h"
        )
        foreach(_forest_widget_header IN LISTS _forest_widget_headers)
            get_filename_component(_forest_widget_name "${_forest_widget_header}" NAME)
            string(REGEX REPLACE "\\.h$" "" _forest_widget_name "${_forest_widget_name}")
            string(TOLOWER "${_forest_widget_name}" _forest_widget_name)
            list(APPEND _forest_qt_widgets_header_names "${_forest_widget_name}")
        endforeach()
    endif()
endforeach()
list(REMOVE_DUPLICATES _forest_qt_widgets_header_names)
if(NOT _forest_qt_widgets_header_names)
    message(FATAL_ERROR "Unable to locate Qt6 Widgets public headers for the module-boundary check.")
endif()

set(_forest_non_ui_dirs core storage config plant system utils common)
set(_forest_non_ui_files "")
foreach(_forest_dir IN LISTS _forest_non_ui_dirs)
    file(GLOB_RECURSE _forest_dir_files LIST_DIRECTORIES FALSE
        "${CMAKE_SOURCE_DIR}/src/${_forest_dir}/*.h"
        "${CMAKE_SOURCE_DIR}/src/${_forest_dir}/*.cpp"
    )
    list(APPEND _forest_non_ui_files ${_forest_dir_files})
endforeach()
list(SORT _forest_non_ui_files)

string(ASCII 239 187 191 _forest_utf8_bom)
foreach(_forest_file IN LISTS _forest_non_ui_files)
    file(READ "${_forest_file}" _forest_content)
    string(REPLACE "\r\n" "\n" _forest_content "${_forest_content}")
    string(REPLACE "\r" "\n" _forest_content "${_forest_content}")
    string(LENGTH "${_forest_content}" _forest_content_length)
    if(_forest_content_length GREATER_EQUAL 3)
        string(SUBSTRING "${_forest_content}" 0 3 _forest_prefix)
        if(_forest_prefix STREQUAL _forest_utf8_bom)
            string(SUBSTRING "${_forest_content}" 3 -1 _forest_content)
        endif()
    endif()

    file(RELATIVE_PATH _forest_relative_file "${CMAKE_SOURCE_DIR}" "${_forest_file}")
    file(TO_CMAKE_PATH "${_forest_relative_file}" _forest_relative_file)
    set(_forest_line_number 1)
    while(TRUE)
        string(FIND "${_forest_content}" "\n" _forest_newline)
        if(_forest_newline EQUAL -1)
            set(_forest_line "${_forest_content}")
            set(_forest_last_line TRUE)
        else()
            string(SUBSTRING "${_forest_content}" 0 ${_forest_newline} _forest_line)
            math(EXPR _forest_next_line "${_forest_newline} + 1")
            string(SUBSTRING "${_forest_content}" ${_forest_next_line} -1 _forest_content)
            set(_forest_last_line FALSE)
        endif()

        if(_forest_line MATCHES "^[ \t]*#[ \t]*include[ \t]*[<\"]([^>\"]+)")
            set(_forest_include "${CMAKE_MATCH_1}")
            string(REPLACE "\\" "/" _forest_include "${_forest_include}")
            string(TOLOWER "${_forest_include}" _forest_include_lower)
            set(_forest_forbidden_include FALSE)
            if(_forest_include_lower MATCHES "(^|/)ui/" OR _forest_include_lower MATCHES "^qtwidgets(/|$)")
                set(_forest_forbidden_include TRUE)
            else()
                get_filename_component(_forest_include_name "${_forest_include_lower}" NAME)
                string(REGEX REPLACE "\\.h$" "" _forest_include_name "${_forest_include_name}")
                list(FIND _forest_qt_widgets_header_names "${_forest_include_name}" _forest_widget_index)
                if(NOT _forest_widget_index EQUAL -1)
                    set(_forest_forbidden_include TRUE)
                endif()
            endif()

            if(_forest_forbidden_include)
                message(FATAL_ERROR
                    "Forbidden UI dependency at ${_forest_relative_file}:${_forest_line_number}: "
                    "'${_forest_include}'")
            endif()
        endif()

        if(_forest_last_line)
            break()
        endif()
        math(EXPR _forest_line_number "${_forest_line_number} + 1")
    endwhile()
endforeach()
